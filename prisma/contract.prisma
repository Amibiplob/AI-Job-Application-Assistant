// use prisma-8

enum ApplicationStatus {
  @@type("pg/text@1")

  SAVED     = "saved"
  APPLIED   = "applied"
  INTERVIEW = "interview"
  REJECTED  = "rejected"
  OFFER     = "offer"
  WITHDRAWN = "withdrawn"
}

enum WorkplaceType {
  @@type("pg/text@1")

  REMOTE = "remote"
  HYBRID = "hybrid"
  ONSITE = "onsite"
}

model User {
  id           Uuid          @id @default(uuid())
  email        String        @unique
  name         String
  createdAt    TimestamptzString(3) @default(now())
  updatedAt    temporal.updatedAtString()
  resumes      Resume[]
  applications Application[]

  @@map("users")
}

model Resume {
  id        Uuid     @id @default(uuid())
  userId    Uuid
  name      String
  content   String
  createdAt TimestamptzString(3) @default(now())
  updatedAt temporal.updatedAtString()
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("resumes")
}

model Job {
  id             Uuid          @id @default(uuid())
  externalId     String?
  source         String
  title          String
  company        String
  location       String?
  workplaceType  WorkplaceType?
  employmentType String?
  salaryMin      Numeric(12, 2)?
  salaryMax      Numeric(12, 2)?
  salaryCurrency VarChar(3)?
  salaryPeriod   String?
  description    String?
  jobUrl         String?
  postedAt       TimestamptzString(3)?
  createdAt      TimestamptzString(3) @default(now())
  updatedAt      temporal.updatedAtString()
  applications   Application[]

  @@unique([source, externalId])
  @@index([source, postedAt])
  @@index([company])
  @@map("jobs")
}

model Application {
  id        Uuid              @id @default(uuid())
  userId    Uuid
  jobId     Uuid
  status    ApplicationStatus @default(SAVED)
  appliedAt TimestamptzString(3)?
  notes     String?
  createdAt TimestamptzString(3) @default(now())
  updatedAt temporal.updatedAtString()
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([userId, jobId])
  @@index([userId, status, updatedAt])
  @@index([jobId])
  @@map("applications")
}
