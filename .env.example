# Database

DATABASE_URL=

# Auth0 — Remote MCP authorization

AUTH0_ISSUER=
AUTH0_AUDIENCE=https://ai-job-application-assistant-lovat.vercel.app/api/mcp
# Comma-separated Auth0 application client IDs reviewed for Authorization Code
# with PKCE. Leave unset until the deployed end-user flow is verified.
AUTH0_INTERACTIVE_CLIENT_IDS=

# Dedicated confidential Auth0 Regular Web Application for account linking.
# Keep the secret server-side. All URLs must be exact HTTPS values.
# Enable only after the Phase 4 staging checklist is verified.
AUTH0_LINK_ENABLED=false
AUTH0_LINK_CLIENT_ID=
AUTH0_LINK_CLIENT_SECRET=
APP_BASE_URL=https://ai-job-application-assistant-lovat.vercel.app
AUTH0_LINK_REDIRECT_URI=https://ai-job-application-assistant-lovat.vercel.app/api/account-link/callback

# Abuse protection: independent random secret, >=32 bytes, shared across instances.
# Required for signup/login and remote MCP. Never prefix with NEXT_PUBLIC_.
RATE_LIMIT_SECRET=
# Optional overrides: RATE_LIMIT_<POLICY>_LIMIT and
# RATE_LIMIT_<POLICY>_WINDOW_SECONDS. See docs/abuse-protection.md.
